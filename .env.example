# Copy to .env and fill in. .env is gitignored.
#
# Only ONE credential is required, and only for commands that actually call a
# model (`ask`, `chat`, `eval`). `./shrimpy test` and `./shrimpy prompt` assemble
# the system prompt offline with dummy credentials and need nothing here.

# https://openrouter.ai/keys  — the same key the tairy-agent deployment uses.
OPENROUTER_API_KEY=

# The model Shrimpy answers with.
SHRIMPY_MODEL=anthropic/claude-sonnet-5

# The (cheaper) model used to grade rubric-based eval cases.
SHRIMPY_JUDGE_MODEL=google/gemini-3.7-flash
